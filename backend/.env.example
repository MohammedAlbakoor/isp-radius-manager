# Database
DATABASE_URL=postgresql://isp_user:isp_password@localhost:5432/isp_radius_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Encryption
ENCRYPTION_KEY=your-encryption-key-min-32-chars-long

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001

# RADIUS Server IP (for setup commands)
RADIUS_SERVER_IP=10.0.0.1
